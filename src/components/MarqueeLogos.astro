---
const techs = [
  "Linux", "React", "Python", "Node.js", "PostgreSQL",
  "Docker", "Arduino", "TypeScript", "VUE", "ASTRO",
];
---

<section class="marquee" aria-label="Tecnologias utilizadas">
  <div class="marquee-track">
    {[...techs, ...techs].map((t) => (
      <span key={t}>{t}</span>
    ))}
  </div>
</section>